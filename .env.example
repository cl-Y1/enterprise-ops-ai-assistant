# ============================================================
# 企业智能运维知识助手 V1.2 环境变量示例
# 使用方法：复制本文件为 .env，再填入你自己的 Dify 应用 API Key。
# 注意：.env 已被 .gitignore 忽略，严禁提交到 GitHub。
# ============================================================

# Dify 应用 API Key（以 app- 开头）。
# 请在 Dify 应用页面进入「访问 API」获取，不要填知识库 API Key。
# 本文件故意留空，未配置时页面会显示「待配置 API Key」。
DIFY_API_KEY=

# Dify Cloud 固定为 https://api.dify.ai/v1；自部署时换成自己的地址。
DIFY_API_BASE_URL=https://api.dify.ai/v1

# Dify 终端用户标识。聊天和反馈必须使用同一个 user。
DIFY_USER_ID=demo-user-001

# 调用 Dify 的读取超时时间（秒）。阻塞模式回答较慢时可适当增大。
DIFY_TIMEOUT=60

# 本地监听地址。默认只允许本机访问，不要随意改成 0.0.0.0。
HOST=127.0.0.1
PORT=5000

# 本地调试开关。交付或演示时保持 0，开启 debug 可能暴露调试信息。
FLASK_DEBUG=0
